  Transient( InitialTime=1.250000e-10 FinalTime=1.300000e-10 InitialStep=1.000e-13 MaxStep=1.000e-12 MinStep=1e-18 Increment=1.5 Decrement=2 )
    { Coupled{ Poisson Electron Hole Contact Circuit }
      CurrentPlot( Time=( Range=(1.250000e-10 1.300000e-10) Intervals=5 ) ) }
  Set( nSN = 1.1 )
