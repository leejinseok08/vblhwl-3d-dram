    AvalancheGeneration( Integrate( Semiconductor ) )
    Band2BandGeneration( Integrate( Semiconductor ) )
  }
}

System {
  CELL c1 ( "bl"=nBL "sn_v"=nSN "gs_v"=nWL "gd_v"=nWL )
  Capacitor_pset Cs ( nSN 0 ) { capacitance = 1.54286e-15 }
