  Derivatives
  RelErrControl
  Digits = 5
  ErrRef(Electron) = 1e+08
  ErrRef(Hole)     = 1e+10
  Iterations =60
  NotDamped  = 10
  RefDens_eGradQuasiFermi_ElectricField = 1e+12
