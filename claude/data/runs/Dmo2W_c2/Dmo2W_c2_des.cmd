File { Output = "Dmo2W_c2_log" }

Device CELL {
  Electrode {
    { Name="bl" Voltage=0.0 }
    { Name="sn_v" Voltage=0.0 }
    { Name="gs_v" Voltage=0.0 WorkFunction=4.7 }
    { Name="gd_v" Voltage=0.0 WorkFunction=4.7 }
    { Name="gp_v" Voltage=0.0 }
  }
  File {
    Grid      = "../_struct/gs_c2hb_msh.tdr"
    Plot      = "Dmo2W_c2_dev.tdr"
    Current   = "Dmo2W_c2_dev.plt"
    Parameter = "../../sdevice_cal_a1.2e20_b2e07_ce41.05.par"
  }
  Physics {
    AreaFactor = 0.1
    Temperature = 300
    EffectiveIntrinsicDensity( OldSlotboom )
    Mobility( DopingDependence eHighFieldSaturation )
    Recombination(
      SRH( DopingDependence TempDependence )
      Band2Band( Model=Hurkx )
      Avalanche( Okuto ElectricField )
    )
  }
  Plot {
    eDensity hDensity ElectrostaticPotential SpaceCharge DopingConcentration
    ElectricField/Vector eCurrent/Vector hCurrent/Vector
    eQuasiFermiPotential hQuasiFermiPotential ConductionBandEnergy ValenceBandEnergy
    AvalancheGeneration Band2BandGeneration SRHRecombination
  }
  CurrentPlot {
    ElectrostaticPotential( (0.12500 0.05000) )   # V_B probe: victim channel centre at body level
    hQuasiFermiPotential( (0.12500 0.05000) )
    eQuasiFermiPotential( (0.12500 0.05000) )
    ElectrostaticPotential( (0.06250 0.05000) )
    hQuasiFermiPotential( (0.06250 0.05000) )
    ElectrostaticPotential( (0.08500 0.05000) )
    hQuasiFermiPotential( (0.08500 0.05000) )
    ElectrostaticPotential( (0.16500 0.05000) )
    hQuasiFermiPotential( (0.16500 0.05000) )
    hDensity( Integrate( Region="R.Ch_v" ) )   # vertical channel sheet
    AvalancheGeneration( Integrate( Semiconductor ) )
    Band2BandGeneration( Integrate( Semiconductor ) )
  }
}

System {
  CELL c1 ( "bl"=nBL "sn_v"=nSN "gs_v"=nWL "gd_v"=nWL )
  Capacitor_pset Cs ( nSN 0 ) { capacitance = 1e-21 }
  Vsource_pset vbl ( nBL 0 ) { pwl = ( 0.000000e+00 0 5.000000e-12 0 1.000000e-11 1.168 1.250000e-10 1.168 1.300000e-10 1.1 1.800000e-10 1.1 ) }
  Vsource_pset vwl ( nWL 0 ) { pwl = ( 0.000000e+00 0 1.000000e-11 0 1.500000e-11 1.8 1.200000e-10 1.8 1.250000e-10 0 1.800000e-10 0 ) }
  Set( nSN = 0 )
  Plot "Dmo2W_c2_sys.plt" ( time() v(nSN) v(nBL) v(nWL) )
}

Math {
  Derivatives
  RelErrControl
  Digits = 5
  ErrRef(Electron) = 1e+08
  ErrRef(Hole)     = 1e+14
  Iterations =60
  NotDamped  = 10
  RefDens_eGradQuasiFermi_ElectricField = 1e+12
  RefDens_hGradQuasiFermi_ElectricField = 1e+12
  Method    = Blocked
  SubMethod = Pardiso
  ACMethod    = Blocked
  ACSubMethod = Pardiso
  Transient = BE
  NumberOfThreads = 4
  ExitOnFailure
  CNormPrint
}
Solve {
  Coupled( Iterations=200 LineSearchDamping=1e-4 ){ Poisson }
  Coupled{ Poisson Electron Hole Contact Circuit }
  Unset( nSN )
  Transient( InitialTime=0.000000e+00 FinalTime=5.000000e-12 InitialStep=5.000e-13 MaxStep=5.000e-12 MinStep=1e-18 Increment=1.5 Decrement=2 )
    { Coupled{ Poisson Electron Hole Contact Circuit }
      CurrentPlot( Time=( Range=(0.000000e+00 5.000000e-12) Intervals=4 ) ) }
  Transient( InitialTime=5.000000e-12 FinalTime=1.500000e-11 InitialStep=1.000e-13 MaxStep=1.000e-12 MinStep=1e-18 Increment=1.5 Decrement=2 )
    { Coupled{ Poisson Electron Hole Contact Circuit }
      CurrentPlot( Time=( Range=(5.000000e-12 1.500000e-11) Intervals=10 ) ) }
  Transient( InitialTime=1.500000e-11 FinalTime=1.150000e-10 InitialStep=2.000e-13 MaxStep=2.000e-12 MinStep=1e-18 Increment=1.5 Decrement=2 )
    { Coupled{ Poisson Electron Hole Contact Circuit }
      CurrentPlot( Time=( Range=(1.500000e-11 1.150000e-10) Intervals=50 ) ) }
  Transient( InitialTime=1.150000e-10 FinalTime=1.200000e-10 InitialStep=1.000e-12 MaxStep=1.000e-11 MinStep=1e-18 Increment=1.5 Decrement=2 )
    { Coupled{ Poisson Electron Hole Contact Circuit }
      CurrentPlot( Time=( Range=(1.150000e-10 1.200000e-10) Intervals=4 ) ) }
  Transient( InitialTime=1.200000e-10 FinalTime=1.250000e-10 InitialStep=1.000e-13 MaxStep=1.000e-12 MinStep=1e-18 Increment=1.5 Decrement=2 )
    { Coupled{ Poisson Electron Hole Contact Circuit }
      CurrentPlot( Time=( Range=(1.200000e-10 1.250000e-10) Intervals=5 ) ) }
  Transient( InitialTime=1.250000e-10 FinalTime=1.300000e-10 InitialStep=1.000e-13 MaxStep=1.000e-12 MinStep=1e-18 Increment=1.5 Decrement=2 )
    { Coupled{ Poisson Electron Hole Contact Circuit }
      CurrentPlot( Time=( Range=(1.250000e-10 1.300000e-10) Intervals=5 ) ) }
  Transient( InitialTime=1.300000e-10 FinalTime=1.800000e-10 InitialStep=2.500e-13 MaxStep=2.500e-12 MinStep=1e-18 Increment=1.5 Decrement=2 )
    { Coupled{ Poisson Electron Hole Contact Circuit }
      CurrentPlot( Time=( Range=(1.300000e-10 1.800000e-10) Intervals=20 ) ) }
  Plot( FilePrefix="end" )
}
