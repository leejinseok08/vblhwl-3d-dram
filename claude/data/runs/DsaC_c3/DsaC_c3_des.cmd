File { Output = "DsaC_c3_log" ACExtract = "DsaC_c3" }

Device CELL {
  Electrode {
    { Name="bl"     Voltage=0.0 }
    { Name="sn_v"   Voltage=0.0 }
    { Name="gs_v"   Voltage=0.0 WorkFunction=4.7 }
    { Name="gd_v"   Voltage=0.0 WorkFunction=4.7 }
    { Name="gp_v"   Voltage=0.0 }
  }
  File {
    Grid      = "../_struct/gs_c3hb_msh.tdr"
    Plot      = "DsaC_c3_dev.tdr"
    Current   = "DsaC_c3_dev.plt"
    Parameter = "../../sdevice_cal_a1.2e20_b2e07_ce41.05.par"
  }
  Physics {
    AreaFactor = 0.1
    Temperature = 300
    EffectiveIntrinsicDensity( OldSlotboom )
    Mobility( DopingDependence eHighFieldSaturation )
    Recombination(
      SRH( DopingDependence TempDependence )
      Band2Band( Model=Hurkx )
    )
  }
}

System {
  CELL c1 ( "bl"=nBL "sn_v"=nSN "gs_v"=nWL "gd_v"=nWL "gp_v"=nGP )
  Vsource_pset vbl ( nBL 0 ) { dc = 0 }
  Vsource_pset vsn ( nSN 0 ) { dc = 0 }
  Vsource_pset vwl ( nWL 0 ) { dc = 0 }
  Vsource_pset vgp ( nGP 0 ) { dc = 0 }
}

Math {
  Extrapolate
  Derivatives
  RelErrControl
  Digits = 5
  ErrRef(Electron) = 1e+08
  ErrRef(Hole)     = 1e+10
  Iterations =40
  NotDamped  = 50
  RefDens_eGradQuasiFermi_ElectricField = 1e+12
  RefDens_hGradQuasiFermi_ElectricField = 1e+12
  Method    = Blocked
  SubMethod = Pardiso
  ACMethod    = Blocked
  ACSubMethod = Pardiso
  Transient = BE
  NumberOfThreads = 4
  ExitOnFailure
  CNormPrint
}
Solve {
  Coupled( Iterations=200 LineSearchDamping=1e-4 ){ Poisson }
  Coupled{ Poisson Electron Hole }
  ACCoupled( StartFrequency=1e6 EndFrequency=1e6 NumberOfPoints=1 Decade Node( nBL nSN nWL nGP ) Exclude( vbl vsn vwl vgp ) )
    { Poisson Electron Hole }
}
