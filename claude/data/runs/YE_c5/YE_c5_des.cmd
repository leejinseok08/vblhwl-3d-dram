# ===================================================================
# YE_c5: DC Id-Vg (Chen Fig.1b/6a/6b)
# structure: gr_c4h   |  Temp=300  GR=1  TAT=0  BTBT=1  II=0  Dit=0  Rb=0.001  Vb=0  Vdd=0.65  Vpp=2  Vnwl=-0.3  Cs=1e-14  WFd=5  WFs=5
# generated by make_runs.py — Chen 2026 BCVFET verification. Sentaurus T-2022.03+ syntax.
# ===================================================================
File {
  Grid      = "../_struct/gr_c4h_msh.tdr"
  Plot      = "YE_c5_dev.tdr"
  Current   = "YE_c5_dev.plt"
  Output    = "YE_c5_log"
  Parameter = "../../sdevice.par"
}
Electrode {
  { Name="bl"     Voltage=0.0 }
  { Name="sn_v"   Voltage=0.0 }
  { Name="gs_v"   Voltage=0.0 WorkFunction=5.0 }
  { Name="gd_v"   Voltage=0.0 WorkFunction=5.0 }
}
Physics {
  Temperature = 300
  EffectiveIntrinsicDensity( OldSlotboom )     # BGN (Chen)
  Mobility( DopingDependence eHighFieldSaturation )   # Chen: thin-layer
  Recombination(
    SRH( DopingDependence TempDependence )      # Chen: SRH; field enhancement = TAT [ASM]
    Band2Band( Model=Hurkx )      # Chen: Hurkx BTBT (GIDL/GIBL)
  )
}
Plot {
  eDensity hDensity ElectrostaticPotential SpaceCharge DopingConcentration
  ElectricField/Vector eCurrent/Vector hCurrent/Vector
  eQuasiFermiPotential hQuasiFermiPotential ConductionBandEnergy ValenceBandEnergy
  AvalancheGeneration Band2BandGeneration SRHRecombination
}
CurrentPlot {
  ElectrostaticPotential( (0.12500 0.04500) )   # V_B probe: victim channel centre at body level
  hQuasiFermiPotential( (0.12500 0.04500) )
  eQuasiFermiPotential( (0.12500 0.04500) )
  ElectrostaticPotential( (0.06250 0.04500) )
  hQuasiFermiPotential( (0.06250 0.04500) )
  ElectrostaticPotential( (0.08500 0.04500) )
  hQuasiFermiPotential( (0.08500 0.04500) )
  ElectrostaticPotential( (0.16500 0.04500) )
  hQuasiFermiPotential( (0.16500 0.04500) )
  hDensity( Integrate( Region="R.Ch_v" ) )   # vertical channel sheet
  AvalancheGeneration( Integrate( Semiconductor ) )
  Band2BandGeneration( Integrate( Semiconductor ) )
}
Math {
  Extrapolate
  Derivatives
  RelErrControl
  Digits = 5
  ErrRef(Electron) = 1e8
  ErrRef(Hole)     = 1e+10
  Iterations =40
  NotDamped  = 50
  RefDens_eGradQuasiFermi_ElectricField = 1e+12
  RefDens_hGradQuasiFermi_ElectricField = 1e+12
  Method    = Blocked
  SubMethod = Pardiso
  ACMethod    = Blocked
  ACSubMethod = Pardiso
  Transient = BE
  NumberOfThreads = 8
  ExitOnFailure
  CNormPrint
}
Solve {
  Coupled( Iterations=200 LineSearchDamping=1e-4 ){ Poisson }
  Coupled{ Poisson Electron Hole }
  Quasistationary( InitialStep=0.02 MaxStep=0.1 MinStep=1e-6 Goal{ Name="gs_v" Voltage=1.8 } Goal{ Name="gd_v" Voltage=1.8 } )
    { Coupled{ Poisson Electron Hole } }
  Quasistationary( InitialStep=0.02 MaxStep=0.1 MinStep=1e-6 Goal{ Name="bl" Voltage=1.1 } )
    { Coupled{ Poisson Electron Hole } }
  NewCurrentFile="IdVg_"
  Quasistationary( InitialStep=2e-3 MaxStep=0.0125 MinStep=1e-7 Goal{ Name="gs_v" Voltage=-1.0 } Goal{ Name="gd_v" Voltage=-1.0 } )
    { Coupled{ Poisson Electron Hole } }
}
