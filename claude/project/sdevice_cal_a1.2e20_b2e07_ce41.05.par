* written by make_runs.py (par_text): parameter file of the Cho-cell decks

Material = "HfO2" {
  Epsilon
  {
    epsilon = 22                * 5 nm gate dielectric; 22 = Sentaurus default
  }
}

Material = "Si3N4" {
  Epsilon
  {
    epsilon = 7.0                 * spacers: Lee .. Yu, IMW 2026 (Sentaurus default 7.5)
  }
}

Material = "SiO2" {
  Epsilon
  {
    epsilon = 3.9
  }
}

Material = "Insulator1" {
  Epsilon
  {
    epsilon = 41.05              * dielectric of the drawn storage capacitor: 3.9 x thickness / EOT (Fig.5(a): 3.8 A)
  }
}

Material = "Silicon" {
  Scharfetter
  {
    taumax  = 1.0000e-05 ,   3.0000e-06     # [s] electrons , holes (default x 1)
  }

  Band2BandTunneling
  {
    Agen = 1.2e+20
    Arec = 1.2e+20
    Bgen = 2e+07
    Brec = 2e+07
  }
}
